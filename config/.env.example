# recruiter_copilot — environment (copy to config/.env). Precedence: CLI > env > config > default.
# Nothing here is required for PROFILE=local (D12, SI1).

# Runtime profile: local | api            (D12)
PROFILE=local

# --- local profile ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# Not a credential: Ollama on localhost ignores it, but the OpenAI client needs a non-empty
# string. Set it only if you put an authenticated reverse proxy in front of Ollama.
OLLAMA_TOKEN=local-no-auth
STT_MODEL=large-v3-turbo          # faster-whisper model; 2.6x faster than large-v3 at equal quality (measured); "small" on CPU
STT_DEVICE=auto                   # auto | cuda | cpu (auto = cuda when ctranslate2 sees a GPU)
STT_COMPUTE_TYPE=auto             # auto = float16 on cuda, int8 on cpu
STT_BIAS_PROMPT=0                 # 1 primes the decode with first-person ownership phrasing (#976); default off = decode unchanged
STT_BIAS_MAX_CHARS=120            # cap for the assembled initial_prompt (Whisper keeps only its tail)
STT_BIAS_INCLUDE_VOCAB=0          # 1 also prepends the question bank + job nouns — measured HARMFUL (#976: repetition loops); keep off

# --- api profile (announced on screen and in every report — SI1) ---
# Any OpenAI-compatible endpoint for chat + transcription:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_STT_MODEL=
# or Anthropic for chat (transcription still needs an OpenAI-compatible STT endpoint):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- privacy (D18, SI3) ---
KEEP_AUDIO=0                      # 1 keeps the WAV after transcription; default discards it
SESSIONS_DIR=./sessions           # where session bundles + live.db live (gitignored)

# --- audio + segmentation (defaults measured on real calls in the sibling project) ---
SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2              # webrtcvad 0-3
VAD_FRAME_MS=20                   # 10 | 20 | 30 only
SEGMENT_SILENCE_SECONDS=0.9       # a PAUSE closes a segment, not a clock
SEGMENT_MAX_SECONDS=30            # safety cap

# --- language handling (D20) ---
STT_BEAM_SIZE=5
STT_DETECT_LANGUAGE=1             # per-segment detection, biased to the session's primary
STT_LANGUAGE_MIN_PROB=0.7         # below this a segment stays in the primary language
STT_CODESWITCH_MODE=split         # split | rescore | off — split cuts audio at the switch

# --- question matcher (D16 — it only ever PROPOSES) ---
MATCHER_ROUTE=lexical             # lexical | llm | hybrid | off
MATCHER_MIN_CONFIDENCE=0.45

# --- server (D14) — loopback only; a deliberate non-loopback host is refused in code ---
# Set the bind host with RECRUITER_COPILOT_HOST (our own namespaced var). A non-loopback value
# here is still refused (D14). Bare HOST is consulted only as a fallback and only when it parses
# as an address, so a generic shell HOST (conda exports HOST=x86_64-conda-linux-gnu) is ignored
# with one INFO line rather than read as a bind address — serve starts on a conda shell.
# `recruiter-copilot serve --host <addr>` overrides this at highest precedence (also loopback-only).
RECRUITER_COPILOT_HOST=127.0.0.1
PORT=8765
